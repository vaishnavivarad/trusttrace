# Copy this file to .env and fill only local development values.
PORT=5000
APP_BASE_URL=http://localhost:5173
# Public URLs used for QR code generation and external mobile device access in production:
FRONTEND_PUBLIC_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
STORAGE_MODE=file
# To use PostgreSQL + Prisma, set STORAGE_MODE=postgres and DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/trusttrace?schema=public
# Blockchain: start the local Hardhat node, deploy ProductAuth, then paste the deployed address.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
# For local development ONLY, use a throwaway Hardhat test account private key.
# Never use a real wallet key here or commit it to source control.
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
# Pinata JWT is required for real IPFS uploads/retrieval. Without it, registration fails clearly.
IPFS_PROVIDER=pinata
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
ML_SERVICE_URL=http://127.0.0.1:8000
MAX_PLAUSIBLE_SPEED_KMH=120
MAX_GPS_ACCURACY_METERS=150
# Set both values before running `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@trusttrace.local
SEED_ADMIN_PASSWORD=change-this-local-password
