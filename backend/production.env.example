# Production / MST Coral Testnet backend configuration TEMPLATE.
# Set these in the hosting provider's secret manager (Render/Railway "Environment"). Do NOT commit real values.
NODE_ENV=production
PORT=10000
TRUST_PROXY=1
STORAGE_MODE=postgres
# Managed Postgres (e.g. Neon) - include sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# >= 32 random chars, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public HTTPS frontend URL (Vercel). Used for CORS and QR verification links.
FRONTEND_PUBLIC_URL=https://YOUR-FRONTEND.vercel.app
FRONTEND_ORIGIN=https://YOUR-FRONTEND.vercel.app
APP_BASE_URL=https://YOUR-FRONTEND.vercel.app
BACKEND_PUBLIC_URL=https://YOUR-BACKEND.onrender.com
# MST Coral Testnet (verified: eth_chainId 0xd56b = 54635)
BLOCKCHAIN_RPC_URL=https://coralrpc.mstblockchain.com
BLOCKCHAIN_CHAIN_ID=54635
BLOCKCHAIN_CONTRACT_ADDRESS=
# MUST be the same wallet that deployed ProductAuth (contract owner). Fresh wallet, testnet funds only.
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
AUTO_RECOVER_LOCAL_CHAIN=false
IPFS_PROVIDER=pinata
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
ML_SERVICE_URL=https://YOUR-ML-SPACE.hf.space
MAX_PLAUSIBLE_SPEED_KMH=120
MAX_GPS_ACCURACY_METERS=150
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
