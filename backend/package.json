{
  "name": "trusttrace-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TrustTrace product registration and three-layer verification API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "sync:local-chain": "node scripts/syncLocalChainState.js",
    "sync:mst": "node scripts/syncMstState.js",
