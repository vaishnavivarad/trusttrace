# MST MAINNET backend configuration TEMPLATE - DO NOT USE until organizer credentials arrive and deployment is approved.
# Before any Mainnet transaction verify:
#   1. eth_chainId on the RPC below returns 0x1226 (4646)
#   2. gas token (MSTC) balance of the deployer wallet is sufficient (ProductAuth deploy est. ~2.62M gas)
#   3. deployer wallet == BLOCKCHAIN_RELAYER_PRIVATE_KEY wallet (contract owner)
#   4. ProductAuth compiled with evmVersion "paris" (no PUSH0/MCOPY)
# Copy every other value from .env.production.example; only the blockchain block differs.
NODE_ENV=production
BLOCKCHAIN_RPC_URL=https://mariorpc.mstblockchain.com
BLOCKCHAIN_CHAIN_ID=4646
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
AUTO_RECOVER_LOCAL_CHAIN=false
# Explorer for links in reports: https://mstscan.com
