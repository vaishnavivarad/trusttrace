# Local Hardhat node
LOCALHOST_RPC_URL=http://127.0.0.1:8545
LOCALHOST_PRIVATE_KEY=

# MST Blockchain Mainnet (Chain ID: 4646, Native Currency: MSTC, Explorer: https://mstscan.com)
# Note: craftrpc.mstblockchain.com is disabled/removed because DNS fails to resolve.
MST_MAINNET_RPC_URL=https://mariorpc.mstblockchain.com

# MST Coral Testnet (Chain ID: 54635, Native Currency: tMSTC, Explorer: https://coral.mstscan.com)
MST_TESTNET_RPC_URL=https://coralrpc.mstblockchain.com

# Set ONLY when explicitly approved to deploy to MST Coral Testnet or MST Mainnet.
# Never commit a real private key to version control.
MST_DEPLOYER_PRIVATE_KEY=

